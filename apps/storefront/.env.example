# Server-side fetches. May be a private URL on the hosting network.
API_INTERNAL_URL=http://localhost:4000/api/v1

# Browser fetches. NEVER put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Shared secret the API presents when purging cache tags. Must match the
# REVALIDATE_SECRET in apps/api.
REVALIDATE_SECRET=replace-me-at-least-16-chars
