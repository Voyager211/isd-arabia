# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database (MongoDB Atlas M0) ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=isd_arabia

# ── Auth ─────────────────────────────────────────────────────────────────
# Secrets must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string-32-chars
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12
# Set in production so the auth cookies are scoped to the shared parent domain.
# COOKIE_DOMAIN=.example.com

# ── Admin seed ───────────────────────────────────────────────────────────
# Optional locally: the seed falls back to superadmin@example.com / @Password123
# with mustChangePassword set. REQUIRED in production — the API and the seed
# script both refuse to start or run without them.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# ── Cloudinary ───────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@daqfxkc3u
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=isd-arabia

# ── CORS (explicit allowlist — never '*') ────────────────────────────────
STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
# EXTRA_CORS_ORIGINS=https://staging.example.com,https://preview.example.com

# ── On-demand storefront revalidation ────────────────────────────────────
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=replace-me-at-least-16-chars

# ── Mail (internal quotation notification only) ──────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ISD Arabia <no-reply@example.com>"
QUOTATION_NOTIFY_TO=sales@example.com
QUOTATION_NOTIFY_ENABLED=true

# ── Spam (Cloudflare Turnstile) ──────────────────────────────────────────
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Local/e2e escape hatch only. Cannot be false in production.
TURNSTILE_ENABLED=false

# ── Alternative: the single string the Cloudinary console gives you ──────
# Paste this instead of the three CLOUDINARY_* values above and the API will
# expand it. Explicitly-set variables win over anything derived from here.
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# The key must have the "Master Admin" role. A "Media Library User" key
# authenticates but cannot upload, which surfaces as a bare 403.
# Verify with: npm run verify:cloudinary --workspace @isd/api
